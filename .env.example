# Copy to .env and fill in. Never commit .env.

# NTA GTFS-Realtime subscription key (developer.nationaltransport.ie). One key is
# shared with 4NextBus and 4NextTram; NTA_LOCK_TABLE (FourNextBus META/RTLOCK)
# keeps combined TripUpdates calls to 1 per 60s.
NTA_API_KEY=
NTA_LOCK_TABLE=FourNextBus

# Station used by the local PoC
POC_STATION=Pearse
POC_DIRECTION=southbound

# AWS (only needed for ingest / deploy from this PC)
AWS_REGION=eu-west-1
AWS_PROFILE=default
FOURNEXTDART_TABLE=FourNextDart

# Deploy inputs (tools/deploy.py stack)
# One skill ID, or two comma-separated (e.g. the live skill and a development copy)
ALEXA_SKILL_ID=
ALERT_EMAIL=
